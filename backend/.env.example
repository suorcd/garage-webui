#
# Path to the Garage configuration file. Defaults to /etc/garage.toml.
#CONFIG_PATH="/etc/garage.toml"
BASE_PATH=""
# Bind address and port for the web server. Defaults: 0.0.0.0 and 3909.
#HOST="0.0.0.0"
#PORT="3909"
# AUTH_USER_PASS holds the login in username:bcrypt-hash format.
# CHANGE_ME is a placeholder, not a real hash. Replace it before use.
# Generate a real hash with this command:
# htpasswd -nbBC 10 "username" "password"
AUTH_USER_PASS='username:CHANGE_ME'
# AUTH_READONLY_USER_PASS holds an optional read-only login in the same
# format. It can call GET endpoints only. Use a different username.
#AUTH_READONLY_USER_PASS='viewer:CHANGE_ME'
API_BASE_URL="http://garage:3903"
S3_ENDPOINT_URL="http://garage:3900"
# Public S3 endpoint URL used to sign presigned download links.
# Defaults to S3_ENDPOINT_URL.
#S3_PUBLIC_ENDPOINT_URL="https://s3.example.com"
# S3 region. Defaults to s3_region from the config file, or "garage".
#S3_REGION="garage"
API_ADMIN_KEY=""
# Disable authentication for local development only. The server logs a warning.
#AUTH_DISABLED=false
# Trusted proxies for X-Forwarded-For and X-Real-IP (IPs and CIDRs, comma separated).
# Only these proxies may set the forwarded headers. Empty means no proxy is trusted.
#TRUSTED_PROXIES="192.0.2.1"
# Maximum upload size in bytes (default 5 GiB).
#MAX_UPLOAD_SIZE=5368709120
# Maximum image size in bytes for thumbnails (default 5 MiB).
#MAX_THUMBNAIL_SIZE=5242880
# Set to false for a plain HTTP install. The session cookie is Secure by
# default, and a browser drops a Secure cookie over plain HTTP.
#SESSION_COOKIE_SECURE=false
# Vite variables for the frontend. The backend ignores them.
# VITE_API_URL is the target of the Vite dev proxy. It defaults to
# http://127.0.0.1:3909. Set it when the API runs on another address.
#VITE_API_URL="http://127.0.0.1:3909"
# VITE_BASE_PATH bakes a base path into the frontend build, for a
# subpath install. It defaults to the root. Set it to the same value
# as BASE_PATH when you build the frontend.
#VITE_BASE_PATH="/sub"
